---
import SupportEmail from './SupportEmail.astro';
import { APP_STORE_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-cta">
    <div>
      <p class="footer-cta__eyebrow">Your keyboard. Your style.</p>
      <h2>Make every tap feel like yours.</h2>
    </div>
    <a class="button button--light" href={APP_STORE_URL}>Download on the App Store</a>
  </div>

  <div class="container footer">
    <div>
      <div class="footer__brand">
        <img src="/app-icon.png" width="28" height="28" alt="" aria-hidden="true" />
        <span>Keyboard Studio</span>
      </div>
      <p class="footer__tagline">
        Custom themes, multilingual typing, and local typing tools for iPhone and iPad.
        Free to download. No subscription.
      </p>
      <p class="footer__tagline">
        Email <SupportEmail /> for Keyboard Studio support.
      </p>
    </div>

    <ul class="footer__links">
      <li><a href="/">Home</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/support/">Support</a></li>
      <li><a href="/terms/">Terms</a></li>
      <li><a href={APP_STORE_URL}>App Store</a></li>
    </ul>

    <p class="footer__meta">
      © {year} Keyboard Studio. For iPhone and iPad.
    </p>
  </div>
</footer>
