---
import { APP_STORE_URL, NAV_LINKS } from '../consts';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container nav">
    <a class="nav__brand" href="/">
      <img src="/app-icon.png" width="32" height="32" alt="Keyboard Studio App Icon" />
      <span>Keyboard Studio</span>
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav__toggle-icon" aria-hidden="true"></span>
    </button>

    <div class="nav__menu" id="site-nav" data-nav-links>
      <ul class="nav__links">
        {
          currentPath === '/' && (
            <li><a href="#features">Features</a></li>
          )
        }
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav__cta" href={APP_STORE_URL}>Get Keyboard Studio</a>
    </div>
  </div>
</header>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const links = document.querySelector('[data-nav-links]');

  if (toggle instanceof HTMLButtonElement && links instanceof HTMLElement) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    links.querySelectorAll('a').forEach((anchor) => {
      anchor.addEventListener('click', () => {
        links.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
